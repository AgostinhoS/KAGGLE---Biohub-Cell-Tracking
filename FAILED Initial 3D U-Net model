id) instead of mimicking laptrack's track_df/split_df/\n# merge_df shape -- there's no third-party API contract to match anymore, so\n# no reason to keep that intermediate around.\n\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import linear_sum_assignment\nfrom scipy.spatial import cKDTree\n\nZ_SCALE_UM = 1.625\nY_SCALE_UM = 0.40625\nX_SCALE_UM = 0.40625\n#percent=0.35 cutoff=100 split_cutoff=64 -> score=0.2761\ndef track_dataset_hungarian(centroids_df, dataset_key, cutoff=10**2, splitting_cutoff=8**2):\n    \"\"\"\n    Link cell centroids across frames with a gated Hungarian assignment and\n    return submission-format rows directly for this dataset -- node rows\n    (row_type='node', node_id set, t/z/y/x set, source_id=target_id=-1) and\n    edge rows (row_type='edge', node_id=-1, t/z/y/x=-1, source_id/target_id\n    set) -- with node_id local (1-indexed) to this dataset, matching\n    sample_submission.csv. No intermediate laptrack-shaped object.\n\n    Linking strategy per consecutive frame pair (t, t+1):\n      1. Primary 1-to-1 assignment via linear_sum_assignment on squared\n         Euclidean cost, gated by `cutoff` (padded with high-cost dummy\n         rows/cols so points can go unmatched instead of being forced\n         together).\n      2. Any frame-(t+1) point left unmatched is checked against ALL frame-t\n         points (nearest neighbor) for a division: if within\n         `splitting_cutoff`, that frame-t point is a division parent. A\n         parent produces at most 2 daughters (its primary match, if any,\n         plus one splitting match); the parent track ends at the division\n         frame and both daughters get fresh track ids.\n    \"\"\"\n\n    df = centroids_df.reset_index(drop=True).copy()\n\n    if len(df) == 0:\n        print(f\"[warn] {dataset_key}: zero centroids detected, skipping tracking\")\n        return pd.DataFrame({\n            \"dataset\": pd.Series(dtype=\"object\"),\n            \"row_type\": pd.Series(dt