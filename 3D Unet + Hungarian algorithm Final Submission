ntermediate around.\n\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import linear_sum_assignment\nfrom scipy.spatial import cKDTree\n\nZ_SCALE_UM = 1.625\nY_SCALE_UM = 0.40625\nX_SCALE_UM = 0.40625\n#percent=0.35 cutoff=100 split_cutoff=64 -> score=0.2761\ndef track_dataset_hungarian(centroids_df, dataset_key, cutoff=10**2, splitting_cutoff=8**2):\n    \"\"\"\n    Link cell centroids across frames with a gated Hungarian assignment and\n    return submission-format rows directly for this dataset -- node rows\n    (row_type='node', node_id set, t/z/y/x set, source_id=target_id=-1) and\n    edge rows (row_type='edge', node_id=-1, t/z/y/x=-1, source_id/target_id\n    set) -- with node_id local (1-indexed) to this dataset, matching\n    sample_submission.csv. No intermediate laptrack-shaped object.\n\n    Linking strategy per consecutive frame pair (t, t+1):\n      1. Primary 1-to-1 assignment via linear_sum_assignment on squared\n         Euclidean cost, gated by `cutoff` (padded with high-cost dummy\n         rows/cols so points can go unmatched instead of being forced\n         together).\n      2. Any frame-(t+1) point left unmatched is checked against ALL frame-t\n         points (nearest neighbor) for a division: if within\n         `splitting_cutoff`, that frame-t point is a division parent. A\n         parent produces at most 2 daughters (its primary match, if any,\n         plus one splitting match); the parent track ends at the division\n         frame and both daughters get fresh track ids.\n    \"\"\"\n    df = centroids_df.reset_index(drop=True).copy()\n    empty_cols = [\"dataset\", \"row_type\", \"node_id\", \"t\", \"z\", \"y\", \"x\", \"source_id\", \"target_id\"]\n    if len(df) == 0 or \"t\" not in df.columns:\n        return pd.DataFrame(columns=empty_cols)\n    frames = sorted(df[\"t\"].unique())\n    if len(frames) == 0:\n        return pd.DataFrame(columns=empty_cols)\n    coordinate_cols = [\"z\", \"x\", \"y\"]\n    split_cutoff_dist = np.sqrt(splitting_cutoff)\n\n    track_id = np.full(len(df), -1, dtype=np.int64)\n    next_track_id = 0\n    division_pairs = []  # (parent_track_id, child_track_id)\n\n    frame_idx = {t: df.index[df[\"t\"] == t].to_numpy() for t in frames}\n\n    for i in frame_idx[frames[0]]:\n        track_id[i] = next_track_id\n        next_track_id += 1\n\n    for t_prev, t_next in zip(frames[:-1], frames[1:]):\n        idx_prev = frame_idx[t_prev]\n        idx_next = frame_idx[t_next]\n        for i in idx_next:\n            track_id[i] = -1\n\n        if len(idx_prev) == 0 or len(idx_next) == 0:\n            for i in idx_next:\n                if track_id[i] == -1:\n                    track_id[i] = next_track_id\n                    next_track_id += 1\n            continue\n\n        coords_prev = df.loc[idx_prev, coordinate_cols].to_numpy(dtype=np.float64)\n        coords_next = df.loc[idx_next, coordinate_cols].to_numpy(dtype=np.float64)\n        scale = np.array([Z_SCALE_UM, X_SCALE_UM, Y_SCALE_UM])  # matches coordinate_cols = [\"z\", \"x\", \"y\"]\n        coords_prev = coords_prev * scale\n        coords_next = coords_next * scale\n        n_p, n_n = len(idx_prev), len(idx_next)\n        diff = coords_prev[:, None, :] - coords_next[None, :, :]\n        cost = np.sum(diff ** 2, axis=2)\n        \n        size = n_p + n_n\n        padded = np.full((size, size), cutoff, dtype=np.float64)\n        padded[:n_p, :n_n] = cost\n        row_ind, col_ind = linear_sum_assignment(padded)\n\n        matched_prev, matched_next = {}, set()\n        for r, c in zip(row_ind, col_ind):\n            if r < n_p and c < n_n and padded[r, c] <= cutoff:\n                matched_prev[r] = c\n                matched_next.add(c)\n                track_id[idx_next[c]] = track_id[idx_prev[r]]\n        \n        leftover_next = [c for c in range(n_n) if c not in matched_next]\n        parent_daughter_count = {r: (1 if r in matched_prev else 0) for r in range(n_p)}\n        # Tracks which parents still have an un-converted primary match sitting\n        # in matched_prev. parent_daughter_count alone can't be used for this:\n        # it can also reach 1 via two splitting daughters on a primary-less\n        # parent, which previously caused a spurious matched_prev[r] KeyError.\n        primary_pending = set(matched_prev.keys())\n        \n        if leftover_next:\n            tree = cKDTree(coords_prev)\n            for c in leftover_next:\n                dist, r = tree.query(coords_next[c], k=1)\n                if dist <= split_cutoff_dist and parent_daughter_count.get(r, 0) < 2:\n                    parent_track = track_id[idx_prev[r]]\n        \n                    if r in primary_pending:\n                        primary_c = matched_prev[r]\n                        primary_child_idx = idx_next[primary_c]\n                        new_primary_track = next_track_id\n                        next_track_id += 1\n                        track_id[primary_child_idx] = new_primary_track\n                        division_pairs.append((parent_track, new_primary_track))\n                        primary_pending.discard(r)\n        \n                    new_daughter_track = next_track_id\n                    next_track_id += 1\n                    track_id[idx_next[c]] = new_daughter_track\n                    division_pairs.append((parent_track, new_daughter_track))\n                    parent_daughter_count[r] += 1\n\n        for c in range(n_n):\n            child_i = idx_next[c]\n            if track_id[child_i] == -1:\n                track_id[child_i] = next_track_id\n                next_track_id += 1\n\n    df[\"track_id\"] = track_id\n    df[\"node_id\"] = range(1, len(df) + 1)  # 1-indexed, local to this dataset\n\n    # --- node rows ---\n    node_df = df.copy()\n    node_df[\"row_type\"] = \"node\"\n    node_df[\"dataset\"] = dataset_key\n    node_df[\"source_id\"] = -1\n    node_df[\"target_id\"] = -1\n\n    # --- within-track edges: shift each track_id's rows by one frame ---\n    df_sorted = df.sort_values([\"track_id\", \"t\"])\n    same_track = df_sorted[\"track_id\"] == df_sorted[\"track_id\"].shift(-1)\n    within_edges = pd.DataFrame({\n        \"source_id\": df_sorted[\"node_id\"][same_track],\n        \"target_id\": df_sorted[\"node_id\"].shift(-1)[same_track],\n    })\n\n    # --- division edges: parent's last node_id -> child's first node_id ---\n    last_node = df.loc[df.groupby(\"track_id\")[\"t\"].idxmax(), [\"track_id\", \"node_id\"]].set_index(\"track_id\")[\"node_id\"]\n    first_node = df.loc[df.groupby(\"track_id\")[\"t\"].idxmin(), [\"track_id\", \"node_id\"]].set_index(\"track_id\")[\"node_id\"]\n\n    if division_pairs:\n        split_df = pd.DataFrame(division_pairs, columns=[\"parent_track_id\", \"child_track_id\"])\n        division_edges = pd.DataFrame({\n            \"source_id\": split_df[\"parent_track_id\"].map(last_node),\n            \"target_id\": split_df[\"child_track_id\"].map(first_node),\n        }).dropna(subset=[\"source_id\", \"target_id\"])\n    else:\n        # Explicit int64 dtype (not the columns=[...] shorthand, which defaults\n        # to object dtype) so concatenating with within_edges below can't silently\n        # upcast source_id/target_id to object.\n        division_edges = pd.DataFrame({\n            \"source_id\": pd.Series(dtype=\"int64\"),\n            \"target_id\": pd.Series(dtype=\"int64\"),\n        })\n\n    edges_df = pd.concat([within_edges, division_edges], ignore_index=True)\n    # Defensive cast: guarantees numeric dtype regardless of which branch above\n    # produced edges_df, so this can never leak object dtype into the submission.\n    edges_df[\"source_id\"] = edges_df[\"source_id\"].astype(\"int64\")\n    edges_df[\"target_id\"] = edges_df[\"target_id\"].astype(\"int64\")\n    edges_df[\"row_type\"] = \"edge\"\n    edges_df[\"dataset\"] = dataset_key\n    edges_df[\"node_id\"] = -1\n    edges_df[\"t\"] = -1\n    edges_df[\"z\"] = -1\n    edges_df[\"y\"] = -1\n    edges_df[\"x\"] = -1\n\n    submission_df = pd.concat([node_df, edges_df], ignore_index=True)\n    return submission_df[[\"dataset\", \"row_type\", \"node_id\", \"t\", \"z\", \"y\", \"x\", \"source_id\", \"target_id\"]]","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-23T15:36:16.648078Z","iopub.status.idle":"2026-09-23T15:36:16.64848Z","shell.execute_reply.started":"2026-09-23T15:36:16.648256Z","shell.execute_reply":"2026-09-23T15:36:16.648294Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# --- build the full submission from every dataset's tracked centroids ---\n# NOTE: node_id is LOCAL to each dataset (matches sample_submission.csv,\n# where node_id restarts per dataset, as verified above). Only the \"id\"\n# column is global/unique across the whole file.\ndfs = []\nrunning_id = 0\nfor key, item in centroidsDict.items():\n    print(item.columns.tolist())\n    submission_df = track_dataset_hungarian(item, key, cutoff=7**2, splitting_cutoff=10**2)\n    submission_df.insert(0, \"id\", range(running_id, running_id + len(submission_df)))\n    running_id += len(submission_df)\n    dfs.append(submission_df)\n\nprint(\"done\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-23T15:36:16.649733Z","iopub.status.idle":"2026-09-23T15:36:16.650039Z","shell.execute_reply.started":"2026-09-23T15:36:16.649872Z","shell.execute_reply":"2026-09-23T15:36:16.649909Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\nsubmission_final = pd.concat(dfs, ignore_index=True)\n\n# match sample_submission.csv exactly: every column is int64, no NaNs/strings\nint_cols = [\"id\", \"node_id\", \"t\", \"z\", \"y\", \"x\", \"source_id\", \"target_id\"]\nfor c in int_cols:\n    submission_final[c] = submission_final[c].round().astype(int)\n\nsubmission_final.to_csv(\"submission.csv\", index=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T05:34:35.20779