      # ---- decoder: cell-center heatmap ----\n        self.centroids = self.UNETdecoder(base_filters, out_channels)\n\n    def _conv_block(self, in_ch, out_ch):\n        return nn.Sequential(\n            nn.Conv3d(in_ch, out_ch, kernel_size=3, padding=1, bias=False),\n            nn.GroupNorm(num_groups=8, num_channels=out_ch),\n            nn.ReLU(inplace=True),\n            nn.Conv3d(out_ch, out_ch, kernel_size=3, padding=1, bias=False),\n            nn.GroupNorm(num_groups=8, num_channels=out_ch),\n            nn.ReLU(inplace=True),\n        )\n\n    def UNETdecoder(self, in_ch, out_ch):\n        # layout: [up, block] x 4, then the 1x1 head  (9 layers)\n        return nn.Sequential(nn.ConvTranspose3d(in_ch * 16, in_ch * 8, kernel_size=2, stride=2),\n                             self._conv_block(in_ch * 16, in_ch * 8),\n                             nn.ConvTranspose3d(in_ch * 8, in_ch * 4, kernel_size=2, stride=2),\n                             self._conv_block(in_ch * 8, in_ch * 4),\n                             nn.ConvTranspose3d(in_ch * 4, in_ch * 2, kernel_size=2, stride=2),\n                             self._conv_block(in_ch * 4, in_ch * 2),\n                             nn.ConvTranspose3d(in_ch * 2, in_ch, kernel_size=2, stride=2),\n                             self._conv_block(in_ch * 2, in_ch),\n                             nn.Conv3d(in_ch, out_ch, kernel_size=1))\n\n    def _decode(self, decoder, b, skips):\n        x = b\n        for i, skip in enumerate(reversed(skips)):            # e4, e3, e2, e1\n            x = decoder[2 * i](x)                              # ConvTranspose3d (upsample)\n            x = decoder[2 * i + 1](torch.cat([x, skip], 1))    # conv_block on [upsampled, skip]\n        return torch.sigmoid(decoder[-1](x))                   # 1x1 head\n\n    def forward(self, x):\n        e1 = self.enc1(x)\n        e2 = self.enc2(self.pool1(e1))\n        e3 = self.enc3(self.pool2(e2))\n        e4 = self.enc4(self.pool3(e3))\n        b = self.bottledropout(self.bottleneck(self.pool4(e4)))\n        skips = [e1, e2, e3, e4]\n\n        return self._decode(self.centroids, b, skips)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-23T15:36:15.228739Z","iopub.execute_input":"2026-09-23T15:36:15.229003Z","iopub.status.idle":"2026-09-23T15:36:15.240519Z","shell.execute_reply.started":"2026-09-23T15:36:15.22898Z","shell.execute_reply":"2026-09-23T15:36:15.239822Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def generate_anisotropic_heatmap(shape, centers, sigma_um=1.5, voxel_size=(1.625, 0.40625, 0.40625)):\n    heatmap = np.zeros(shape, dtype=np.float32)\n    if len(centers) == 0:\n        return heatmap\n\n    mask = np.ones(shape, dtype=bool)\n    for z, y, x in np.rint(centers).astype(int):\n        if 0 <= z < shape[0] and 0 <= y < shape[1] and 0 <= x < shape[2]:\n            mask[z, y, x] = False  \n\n    if mask.all():\n        return heatmap\n    \n    dist = ndi.distance_transform_edt(mask, sampling=voxel_size)  \n    return np.exp(-dist**2 / (2 * sigma_um**2)).astype(np.float32)\n\ndef normalize_volume_slice(x, lo=1.0, hi=99.0):\n    p_lo, p_hi = np.percentile(x, [lo, hi])\n    if p_hi <= p_lo:\n        return np.zeros_like(x, dtype=np.float32)\n    return np.clip((x.astype(np.float32) - p_lo) / (p_hi - p_lo), 0, 1)\n\nclass ZarrPatchDataset(Dataset):\n    def __init__(self, zarrFile, nodes_df, edges_df, ids, patch_size=(1, 64, 256, 256), train=True):\n        self.files = zarrFile\n        self.ids_list = ids\n        self.patch_size = patch_size\n        self.nodes_grouped = {k: v for k, v in nodes_df.groupby(\"file_id\")}\n        self.edges_grouped = {k: v for k, v in edges_df.groupby(\"file_id\")}\n        self.train = train\n\n    def __len__(self):\n        return len(self.ids_list)\n\n    def __getitem__(self, idx):\n        name = self.ids_list[idx]\n        full_volume = self.files[f\"{name}Zarr\"] \n        \n        pt, pz, py, px = self.patch_size\n        t_max = full_volume.shape[0]\n\n        start_t = np.random.randint(0, max(1, t_max - pt + 1))\n        \n        img_patch = np.asarray(full_volume[start_t:start_t+pt])\n\n        img_patch = img_patch.squeeze(0)\n        img_patch = normalize_volume_slice(img_patch)\n        final = torch.tensor(img_patch, dtype=torch.float32).unsqueeze(0)\n\n        if self.train:\n            name_geff = f\"{name}Geff\"\n            node_coords_df = self.nodes_grouped.get(\n                name_geff, pd.DataFrame(columns=[\"t\", \"z\", \"y\", \"x\"])\n            )\n\n            patch_coords = [\n                (z, y, x)\n                for t, z, y, x in node_coords_df[[\"t\", \"z\", \"y\", \"x\"]].itertuples(index=False)\n                if start_t <= t < start_t + pt\n            ]\n            target_patch = generate_anisotropic_heatmap(self.patch_size[1:], patch_coords)\n            return final, torch.tensor(target_patch, dtype=torch.float32).unsqueeze(0)\n\n        return final","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-23T15:36:15.241456Z","iopub.execute_input":"2026-09-23T15:36:15.241663Z","iopub.status.idle":"2026-09-23T15:36:15.261612Z","shell.execute_reply.started":"2026-09-23T15:36:15.241644Z","shell.execute_reply":"2026-09-23T15:36:15.260996Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class AdaptiveWingLoss(nn.Module):\n    def __init__(self, omega=14, theta=0.5, epsilon=1, alpha=2.1):\n        super(AdaptiveWingLoss, self).__init__()\n        self.omega = omega\n        self.theta = theta\n        self.epsilon = epsilon\n        self.alpha = alpha\n\n    def forward(self, pred, target):\n        '''\n        :param pred: BxNxHxH\n        :param target: BxNxHxH\n        :return:\n        '''\n\n        y = target\n        y_hat = pred\n        delta_y = (y - y_hat).abs()\n        delta_y1 = delta_y[delta_y < self.theta]\n        delta_y2 = delta_y[delta_y >= self.theta]\n        y1 = y[delta_y < se